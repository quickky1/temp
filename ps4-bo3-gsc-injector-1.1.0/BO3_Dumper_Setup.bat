:: ---------- [2/3] Install simplified UI ----------
echo [2/3] Installing simplified UI...
if not exist "%PROJ%\MainWindow.cs" (
    echo [ERROR] Project folder not found:
    echo %PROJ%
    echo.
    echo Right-click this bat, choose Edit, and fix the "set PROJ=" line.
    pause
    exit /b 1
)
copy /Y "%PROJ%\MainWindow.cs" "%PROJ%\MainWindow.cs.bak" >nul
copy /Y "%PROJ%\MainWindow.Designer.cs" "%PROJ%\MainWindow.Designer.cs.bak" >nul
copy /Y "%TEMP%\MainWindow.cs" "%PROJ%\MainWindow.cs" >nul
copy /Y "%TEMP%\MainWindow.Designer.cs" "%PROJ%\MainWindow.Designer.cs" >nul
del "%TEMP%\MainWindow.cs" "%TEMP%\MainWindow.Designer.cs" >nul 2>&1
echo      Installed. Originals backed up as .bak files.

:: ---------- [3/3] Push to GitHub ----------
echo [3/3] Pushing to GitHub...
where git >nul 2>&1
if errorlevel 1 (
    echo [ERROR] git is not installed or not on PATH.
    echo Install it from https://git-scm.com/download/win and run this again.
    pause
    exit /b 1
)
set "GITROOT="
for %%D in ("%PROJ%" "%PROJ%\.." "%PROJ%\..\.." "%PROJ%\..\..\..") do (
    if not defined GITROOT (
        if exist "%%~fD\.git" set "GITROOT=%%~fD"
    )
)
if not defined GITROOT (
    set "GITROOT=%PROJ%\..\.."
    echo      No git repo found, initializing at %GITROOT%
    git -C "%GITROOT%" init >nul 2>&1
)
pushd "%GITROOT%"
git remote remove origin 2>nul
git remote add origin %REPO%
git branch -M main
git add -A
set /p msg="Commit message (Enter for default 'simplified dumper'): "
if "%msg%"=="" set msg=simplified dumper
git commit -m "%msg%" >nul 2>&1
git push -u origin main
set "PUSHERR=%errorlevel%"
popd

echo.
if not "%PUSHERR%"=="0" (
    echo Push hit an issue. If it asked for a login, sign in with your
    echo GitHub account (a browser window may open), then run this again.
) else (
    echo All done! Simplified UI installed and pushed to:
    echo https://github.com/quickky1/temp
    echo.
    echo Next: open the solution in Visual Studio and Rebuild.
)
pause
