echo %PROJ%
echo.
echo Right-click this bat, choose Edit, and fix the "set PROJ=" line at the top.
pause
exit /b 1

:build
echo [3/4] Building...
set "SLN="
for %%F in ("%PROJ%\..\*.sln") do set "SLN=%%~fF"
if defined SLN goto have_sln
for %%F in ("%PROJ%\*.sln") do set "SLN=%%~fF"
:have_sln
if not defined SLN goto no_sln
set "MSBUILD="
set "MSBUILD="
set "VSWHERE="
if exist "%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe" set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
if not defined VSWHERE if exist "%ProgramFiles%\Microsoft Visual Studio\Installer\vswhere.exe" set "VSWHERE=%ProgramFiles%\Microsoft Visual Studio\Installer\vswhere.exe"
if not defined VSWHERE goto vswhere_done
for /f "usebackq delims=" %%I in (`"%VSWHERE%" -latest -products * -requires Microsoft.Component.MSBuild -find MSBuild\**\Bin\MSBuild.exe`) do if not defined MSBUILD set "MSBUILD=%%I"
:vswhere_done
if defined MSBUILD goto have_msbuild
set "MSBUILD=%ProgramFiles%\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\MSBuild.exe"
if exist "%MSBUILD%" goto have_msbuild
set "MSBUILD=%ProgramFiles%\Microsoft Visual Studio\2022\Community\MSBuild\Current\Bin\MSBuild.exe"
if exist "%MSBUILD%" goto have_msbuild
set "MSBUILD=%ProgramFiles(x86)%\Microsoft Visual Studio\2022\BuildTools\MSBuild\Current\Bin\MSBuild.exe"
if exist "%MSBUILD%" goto have_msbuild
set "MSBUILD=%ProgramFiles(x86)%\Microsoft Visual Studio\2019\Community\MSBuild\Current\Bin\MSBuild.exe"
if exist "%MSBUILD%" goto have_msbuild
set "MSBUILD=%ProgramFiles(x86)%\Microsoft Visual Studio\2019\BuildTools\MSBuild\Current\Bin\MSBuild.exe"
if exist "%MSBUILD%" goto have_msbuild
for /f "delims=" %%M in ('where msbuild.exe 2^>nul') do if not defined MSBUILD set "MSBUILD=%%M"
if defined MSBUILD goto have_msbuild
goto no_msbuild
:have_msbuild
echo      MSBuild: %MSBUILD%
"%MSBUILD%" "%SLN%" /t:Rebuild /p:Configuration=Release "/p:Platform=Any CPU" /m /verbosity:minimal /nologo
if errorlevel 1 goto build_fail
echo      Build succeeded.
set "BUILDOK=1"
goto push
:build_fail
echo.
echo [ERROR] Build failed - see the errors above.
goto push
:no_sln
echo [ERROR] Could not find the .sln file near:
echo %PROJ%
pause
exit /b 1
:no_msbuild
echo [ERROR] MSBuild not found. Install Visual Studio with the
echo ".NET desktop development" workload, then run this again.
pause
exit /b 1

:push
echo [4/4] Pushing to GitHub...
where git >nul 2>&1
if errorlevel 1 goto no_git
set "GITROOT="
for %%D in ("%PROJ%" "%PROJ%\.." "%PROJ%\..\.." "%PROJ%\..\..\..") do if not defined GITROOT if exist "%%~fD\.git" set "GITROOT=%%~fD"
if defined GITROOT goto have_root
set "GITROOT=%PROJ%\..\.."
echo      No git repo found, initializing...
git -C "%GITROOT%" init >nul 2>&1
:have_root
pushd "%GITROOT%"
git remote remove origin 2>nul
git remote add origin %REPO%
git branch -M main
git add -A
set /p msg="Commit message (Enter for default 'simplified dumper'): "
if "%msg%"=="" set msg=simplified dumper
git commit -m "%msg%" >nul 2>&1
git push -u origin main
if errorlevel 1 goto pushed
set "PUSHERR=0"
:pushed
popd
goto result
:no_git
echo [ERROR] git is not installed or not on PATH.
echo Install it from https://git-scm.com/download/win and run this again.
pause
exit /b 1

:result
echo.
echo ============ RESULT ============
if "%BUILDOK%"=="1" goto build_ok
echo Build: FAILED - the exe was not updated.
goto build_done
:build_ok
echo Build: OK - run the new exe from:
echo %PROJ%\bin\Release
:build_done
if "%PUSHERR%"=="0" goto push_ok
echo Push: had an issue - sign in to GitHub if asked, then run again.
goto done
:push_ok
echo Push: OK - https://github.com/quickky1/temp
:done
pause
